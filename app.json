{
  "expo": {
    "name": "WHOOP Health",
    "slug": "whoop-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-asset",
      ["@kingstinct/react-native-healthkit", {
        "NSHealthShareUsageDescription": "Used to read your health metrics for recovery and sleep analysis."
      }]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "bdc404cd-4bde-4b82-9570-9d7d3961d71c"
      }
    },
    "owner": "abhk",
    "updates": {
      "url": "https://u.expo.dev/bdc404cd-4bde-4b82-9570-9d7d3961d71c"
    }
  }
}
